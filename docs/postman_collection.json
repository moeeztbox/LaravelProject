{
	"info": {
		"_postman_id": "b7e2a6b0-1c1a-4b8a-9a3e-project-management-api",
		"name": "Project Management API",
		"description": "API collection for the Project Management app. Covers Authentication, Projects, Tasks, and Task Assignment, with happy-path and denied-case (401/403/422) examples for each. Also includes Profile Upload and Task Collaborators for full endpoint coverage.\n\nSet `base_url` and log in via the Authentication folder first — the login/register requests automatically save the returned token into the `token` collection variable, which every other request uses as its Bearer token.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{token}}", "type": "string" }
		]
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
		{ "key": "token", "value": "", "type": "string" },
		{ "key": "admin_token", "value": "", "type": "string" },
		{ "key": "manager_token", "value": "", "type": "string" },
		{ "key": "employee_token", "value": "", "type": "string" },
		{ "key": "other_employee_token", "value": "", "type": "string" },
		{ "key": "project_id", "value": "1", "type": "string" },
		{ "key": "other_project_id", "value": "2", "type": "string" },
		{ "key": "task_id", "value": "1", "type": "string" },
		{ "key": "other_task_id", "value": "2", "type": "string" },
		{ "key": "user_id", "value": "1", "type": "string" }
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register (happy path)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set('token', pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"New User\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
					},
					"response": [
						{
							"name": "201 Created",
							"originalRequest": { "method": "POST", "url": "{{base_url}}/register" },
							"code": 201,
							"status": "Created",
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"message\": \"User registered successfully.\",\n    \"user\": {\n        \"id\": 10,\n        \"name\": \"New User\",\n        \"email\": \"newuser@example.com\",\n        \"role\": null,\n        \"created_at\": \"2026-08-04T07:00:00.000000Z\",\n        \"updated_at\": \"2026-08-04T07:00:00.000000Z\"\n    },\n    \"token\": \"1|abcdef1234567890\"\n}"
						}
					]
				},
				{
					"name": "Register - Validation Error (422)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"\",\n    \"email\": \"not-an-email\",\n    \"password\": \"short\"\n}"
						},
						"url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] }
					},
					"response": [
						{
							"name": "422 Unprocessable Content",
							"originalRequest": { "method": "POST", "url": "{{base_url}}/register" },
							"code": 422,
							"status": "Unprocessable Content",
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"message\": \"The name field is required. (and 2 more errors)\",\n    \"errors\": {\n        \"name\": [\"The name field is required.\"],\n        \"email\": [\"The email field must be a valid email address.\"],\n        \"password\": [\"The password field must be at least 8 characters.\"]\n    }\n}"
						}
					]
				},
				{
					"name": "Login (happy path)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.set('token', pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
					},
					"response": [
						{
							"name": "200 OK",
							"originalRequest": { "method": "POST", "url": "{{base_url}}/login" },
							"code": 200,
							"status": "OK",
							"header": [{ "key": "Content-Type", "value": "application/json" }],
							"body": "{\n    \"message\": \"Login successful.\",\n    \"user\": {\n        \"id\": 10,\n        \"name\": \"New User\",\n        \"email\": \"newuser@example.com\",\n        \"role\": null,\n        \"created_at\": \"2026-08-04T07:00:00.000000Z\",\n        \"updated_at\": \"2026-08-04T07:00:00.000000Z\"\n    },\n    \"token\": \"2|ghijkl1234567890\"\n}"
						}
					]
				},
